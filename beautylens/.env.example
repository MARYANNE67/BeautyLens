MODEL_PATH=models/final/best.pt
ALLOWED_ORIGINS=http://localhost:19000

# ---------------------------------------------------------------------------
# Firebase Auth -- BACKEND (REQUIRED. Service account key is SECRET; never
# commit the .json)
# ---------------------------------------------------------------------------
# Firebase Console > Project settings > Service accounts > Generate new private
# key. Save the downloaded file outside the repo (or rely on .gitignore) and
# point this at it.
#
# This is not optional: firebase-admin builds an authorized session to fetch
# Google's token-signing certs, so verifying ID tokens needs real credentials.
# Without it the server logs a setup error on startup and every authenticated
# endpoint returns 503.
FIREBASE_CREDENTIALS_FILE=C:/secrets/beautylens-service-account.json
#
# Alternative for hosts where you can only set env vars, not upload files:
# paste the whole service-account JSON on one line.
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
#
# Optional: normally taken from the service-account file, falling back to
# EXPO_PUBLIC_FIREBASE_PROJECT_ID below. Set only to override both.
# FIREBASE_PROJECT_ID=beautylens-xxxxx

# ---------------------------------------------------------------------------
# Firebase Auth -- APP (web config, safe to ship; these are not secrets)
# ---------------------------------------------------------------------------
# Firebase Console > Project settings > Your apps > Web app (</> icon).
# Restart Expo with `npx expo start -c` after changing these.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional -- the app normally auto-detects the dev API URL from the Metro
# connection your phone/simulator already made (see src/config/featureFlags.ts).
# Only set this if that detection doesn't work for your setup (e.g. a tunnel
# URL, or a backend port other than 8000).
# EXPO_PUBLIC_API_BASE_URL_DEV=http://192.168.1.23:8000

# Production API URL, used in release builds.
# EXPO_PUBLIC_API_BASE_URL_PROD=https://your-production-api.com