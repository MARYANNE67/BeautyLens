{
  "expo": {
    "name": "beautylens",
    "slug": "beautylens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "beautylens",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.beautylens.app",
      "infoPlist": {
        "NSCameraUsageDescription": "BeautyLens uses the camera to detect your face and show makeup placement guidance."
      }
    },
    "android": {
      "package": "com.beautylens.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "BeautyLens uses the camera to detect your face and show makeup placement guidance."
        }
      ],
      "./plugins/withMediapipeModel.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiBaseUrlDev": "http://10.0.0.234:8000",
      "apiBaseUrlProd": "https://your-production-api.com"
    }
  }
}
