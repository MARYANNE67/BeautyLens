# Upload context for `gcloud run deploy --source .` -- mirror of .dockerignore.
# Model weights and the shade catalog are fetched at container start from the
# HF artifact repo, so they stay out of the upload too.
.git
**/node_modules
**/.venv
**/venv
**/.expo
**/ios
**/__pycache__
**/.pytest_cache
beautylens/beautylens.db
beautylens/.coverage
beautylens/.env
beautylens/models
beautylens/data/sources
beautylens/data/shade_catalog_seed.json
beautylens/tests/fixtures
docs
